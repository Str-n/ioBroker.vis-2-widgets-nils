        "radiusChip": "16px",
        "shadowControl": "0 4px 12px rgba(23, 47, 64, 0.18)",
        "shadowCard": "0 8px 24px rgba(23, 47, 64, 0.20)",
        "shadowBadge": "0 1px 3px rgba(23, 47, 64, 0.30)",
        "legacyShadowColor": "rgba(23, 47, 64, 0.25)"
    },
    "components": {
        "MuiPaper": { "styleOverrides": { "root": { "backgroundImage": "none" } } }
